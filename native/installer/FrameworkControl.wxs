<?xml version='1.0' encoding='windows-1252'?>
<!--
  Framework Control (native) installer, WiX Toolset v3.

  Installs the unchanged background service (registered through WinSW, same
  as upstream) plus the native desktop app, and points the Start Menu/Desktop
  shortcuts at the app instead of a browser.

  Built by native/installer/build-msi.ps1, which passes:
    -dVersion=<x.y.z>  -dStage=<folder with the files below>

  The UpgradeCode matches upstream's MSI on purpose: installing this replaces
  an existing upstream install (same service, same config) instead of
  installing a second copy next to it. Settings in %PROGRAMDATA% are kept.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Framework Control'
        UpgradeCode='5DBB12AC-A119-41F9-A1FF-98447249AC33'
        Manufacturer='Framework Control contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Framework Control native app and background service'
            Manufacturer='Framework Control contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            Platform='x64'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <Icon Id='AppIcon.ico' SourceFile='$(var.Stage)\app.ico'/>
        <Property Id='ARPPRODUCTICON' Value='AppIcon.ico'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/kingof9x/framework-control-windows-naitive'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/kingof9x/framework-control-windows-naitive#readme'/>
        <Property Id='ARPURLUPDATEINFO' Value='https://github.com/kingof9x/framework-control-windows-naitive/releases'/>
        <Property Id='ARPCOMMENTS' Value='Fan, power and battery control for Framework laptops, with a native Windows app.'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramMenuFolder'/>
            <Directory Id='DesktopFolder'/>
            <Directory Id='CommonAppDataFolder'>
                <Directory Id='ProgramDataFrameworkControlDir' Name='FrameworkControl'>
                    <Directory Id='ProgramDataAssetsDir' Name='assets'/>
                </Directory>
            </Directory>

            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='APPLICATIONFOLDER' Name='FrameworkControl'>

                    <!-- Native desktop app + its shortcuts -->
                    <Component Id='NativeApp' Guid='3C6B2D7E-41A9-4B57-9E0F-6A8D2C1B9F43' Win64='yes'>
                        <File Id='AppExe' Name='framework-control-app.exe' Source='$(var.Stage)\framework-control-app.exe' KeyPath='yes'>
                            <Shortcut Id='StartMenuShortcut' Directory='ProgramMenuFolder' Name='Framework Control'
                                Description='Fan, power and battery control' WorkingDirectory='APPLICATIONFOLDER'
                                Icon='AppIcon.ico' IconIndex='0' Advertise='yes'/>
                        </File>
                    </Component>

                    <Component Id='DesktopShortcut' Guid='8E2F5A41-0C7D-4E36-B1A9-5D3C7F2E6B18' Win64='yes'>
                        <Condition>INSTALLDESKTOPSHORTCUT = "1"</Condition>
                        <Shortcut Id='DesktopShortcutLnk' Directory='DesktopFolder' Name='Framework Control'
                            Description='Fan, power and battery control' Target='[APPLICATIONFOLDER]framework-control-app.exe'
                            WorkingDirectory='APPLICATIONFOLDER' Icon='AppIcon.ico' IconIndex='0'/>
                        <RegistryValue Root='HKLM' Key='Software\FrameworkControl' Name='DesktopShortcut' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>

                    <!-- Background service (identical to upstream's layout) -->
                    <Component Id='WinSwComponent' Guid='*' Win64='yes'>
                        <File Id='WinSwExe' Name='FrameworkControlService.exe' Source='$(var.Stage)\FrameworkControlService.exe' KeyPath='yes'/>
                        <ServiceInstall
                            Id='FrameworkControlServiceInstall'
                            Name='FrameworkControlService'
                            DisplayName='Framework Laptop Control Service'
                            Description='Framework control HTTP bridge'
                            Start='auto'
                            Type='ownProcess'
                            ErrorControl='normal'
                            Account='LocalSystem'/>
                        <ServiceControl
                            Id='FrameworkControlServiceControl'
                            Name='FrameworkControlService'
                            Start='install'
                            Stop='both'
                            Remove='uninstall'
                            Wait='yes'/>
                    </Component>

                    <Component Id='WinSwConfigComponent' Guid='*' Win64='yes'>
                        <File Id='WinSwXml' Name='FrameworkControlService.xml' Source='$(var.Stage)\FrameworkControlService.xml' KeyPath='yes'/>
                    </Component>

                    <Component Id='ServiceBinary' Guid='*' Win64='yes'>
                        <File Id='ServiceExe' Name='framework-control-service.exe' Source='$(var.Stage)\framework-control-service.exe' KeyPath='yes'/>
                        <RemoveFile Id='RemoveRyzenAdjExe' Name='ryzenadj.exe' On='uninstall' Directory='APPLICATIONFOLDER'/>
                        <RemoveFile Id='RemoveRyzenAdjNested' Name='*' On='uninstall' Directory='RyzenAdjDir'/>
                        <RemoveFolder Id='RemoveRyzenAdjFolder' Directory='RyzenAdjDir' On='uninstall'/>
                    </Component>

                    <!-- Runtime files the service creates, removed only on a real uninstall (not on updates). -->
                    <Component Id='RuntimeDataCleanup' Guid='B6F3C2A1-8D45-4E9C-A3B7-1F0E5D2C7A84' Win64='yes'>
                        <Condition>NOT UPGRADINGPRODUCTCODE</Condition>
                        <CreateFolder/>
                        <!-- Browser shortcuts an upstream install may have created -->
                        <RemoveFile Id='RemoveStartMenuUrl' Name='Framework Control.url' On='uninstall' Directory='ProgramMenuFolder'/>
                        <RemoveFile Id='RemoveDesktopUrl' Name='Framework Control.url' On='uninstall' Directory='DesktopFolder'/>
                        <RemoveFile Id='RemoveServiceLogs' Name='*.log' On='uninstall' Directory='APPLICATIONFOLDER'/>
                        <RemoveFile Id='RemoveServiceLogsOld' Name='*.log.old' On='uninstall' Directory='APPLICATIONFOLDER'/>
                        <RemoveFile Id='RemoveFrameworkTool' Name='framework_tool.exe' On='uninstall' Directory='APPLICATIONFOLDER'/>
                        <RemoveFile Id='RemoveZipPeekFiles' Name='*' On='uninstall' Directory='ZipPeekDir'/>
                        <RemoveFolder Id='RemoveZipPeekDir' Directory='ZipPeekDir' On='uninstall'/>
                        <RemoveFile Id='RemoveIcon' Name='framework-control.ico' On='uninstall' Directory='ProgramDataAssetsDir'/>
                        <RemoveFile Id='RemoveConfig' Name='config.json' On='uninstall' Directory='ProgramDataFrameworkControlDir'/>
                        <RemoveFile Id='RemoveBatteryHistory' Name='battery-history.json' On='uninstall' Directory='ProgramDataFrameworkControlDir'/>
                        <RemoveFile Id='RemoveBatteryHistoryTmp' Name='battery-history.json.tmp' On='uninstall' Directory='ProgramDataFrameworkControlDir'/>
                        <RemoveFolder Id='RemoveProgramDataAssetsDir' Directory='ProgramDataAssetsDir' On='uninstall'/>
                        <RemoveFolder Id='RemoveProgramDataFrameworkControlDir' Directory='ProgramDataFrameworkControlDir' On='uninstall'/>
                    </Component>

                    <Directory Id='RyzenAdjDir' Name='ryzenadj'/>
                    <Directory Id='ZipPeekDir' Name='fc_zip_peek'/>
                </Directory>
            </Directory>
        </Directory>

        <!-- Desktop shortcut is on by default; `msiexec /i ... INSTALLDESKTOPSHORTCUT=0` skips it. -->
        <Property Id='INSTALLDESKTOPSHORTCUT' Value='1' Secure='yes'/>

        <!--
          Everything lives in the 'Binaries' feature: the service's in-app
          updater runs `msiexec /i ... ADDLOCAL=Binaries /qn`, so anything
          outside it would be dropped on update.
        -->
        <Feature Id='Binaries' Title='Framework Control' Level='1' Absent='disallow' AllowAdvertise='no'
            ConfigurableDirectory='APPLICATIONFOLDER'>
            <ComponentRef Id='NativeApp'/>
            <ComponentRef Id='DesktopShortcut'/>
            <ComponentRef Id='WinSwComponent'/>
            <ComponentRef Id='WinSwConfigComponent'/>
            <ComponentRef Id='ServiceBinary'/>
            <ComponentRef Id='RuntimeDataCleanup'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Offer to launch the app when the wizard finishes. -->
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Open Framework Control'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
        <Property Id='WixShellExecTarget' Value='[#AppExe]'/>
        <CustomAction Id='LaunchApplication' BinaryKey='WixCA' DllEntry='WixShellExec' Impersonate='yes'/>

        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
            <!-- Skip the license page -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='InstallDirDlg' Order='99'>NOT Installed</Publish>
            <Publish Dialog='InstallDirDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchApplication'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
    </Product>
</Wix>
